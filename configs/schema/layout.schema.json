{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/doom-level-agent/layout.schema.json",
  "title": "DoomLayoutV0",
  "type": "object",
  "required": ["name", "rooms", "connections", "things"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "theme": { "type": "string" },
    "brief": { "type": "string" },
    "objective_room": { "type": "string" },
    "part_designs": {
      "type": "array",
      "description": "Per-room micro-design notes. Prefer measurable strings (sizes, light ints, named textures, kind=lift). See configs/prompts/layout_json_format.md.",
      "items": {
        "type": "object",
        "required": ["id", "detail"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "Matches a room id when possible." },
          "role": {
            "type": "string",
            "description": "start|teach|choke|hub|key|hazard|arena|secret|optional|exit|closet"
          },
          "shape": {
            "type": "string",
            "description": "Measurable footprint, e.g. '320x160 wide' or 'L: main 384x288 + east wing 160x160'."
          },
          "elevation": {
            "type": "string",
            "description": "Exact floor/ceil; STEP<=24 or kind=lift — no silent permanent drops."
          },
          "cover": {
            "type": "string",
            "description": "Prop type/size/placement; keep off walk midlines."
          },
          "mobs": { "type": "string" },
          "triggers": {
            "type": "string",
            "description": "lock color, walk closet, lift, exit — named explicitly."
          },
          "light": {
            "type": "string",
            "description": "Integers / hierarchy, e.g. '160 mid; maze 64+special 17'."
          },
          "textures": {
            "type": "string",
            "description": "Named wall+floor+ceil (BROWN96 / FLOOR1_1 / CEIL1_2)."
          },
          "detail": { "type": "string", "description": "One concrete player-experience sentence." }
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "w", "h"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "w": { "type": "integer", "minimum": 64 },
          "h": { "type": "integer", "minimum": 64 },
          "floor_height": { "type": "integer", "default": 0 },
          "ceiling_height": { "type": "integer", "default": 128 },
          "floor_flat": { "type": "string", "default": "FLOOR0_1" },
          "ceil_flat": { "type": "string", "default": "CEIL1_1" },
          "light": { "type": "integer", "minimum": 0, "maximum": 255, "default": 160 },
          "light_special": {
            "type": "integer",
            "description": "Doom sector light special (e.g. 1 random blink, 8 glow, 17 flicker)."
          },
          "wall_texture": { "type": "string", "default": "STARTAN2" },
          "role": { "type": "string" },
          "shape": {
            "type": "string",
            "description": "Use L with wing_side/wing_w/wing_h for true L polygons. Do not emit a separate *_wing room.",
            "enum": [
              "rect",
              "narrow",
              "wide",
              "L",
              "U",
              "alcove",
              "arena",
              "hub",
              "dogleg"
            ]
          },
          "wing_side": {
            "type": "string",
            "enum": ["north", "south", "east", "west"],
            "description": "Required when shape is L. Portal openings must sit inside the real wing face span with margins."
          },
          "wing_w": { "type": "integer", "minimum": 64 },
          "wing_h": { "type": "integer", "minimum": 64 },
          "design": { "type": "string" }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b"],
        "additionalProperties": false,
        "properties": {
          "a": { "type": "string" },
          "b": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["corridor", "door", "open", "lift"],
            "default": "open",
            "description": "Use lift for rideable height changes (>24 or return trip). door+lock for keyed gates."
          },
          "lock": {
            "type": "string",
            "enum": ["blue", "yellow", "red"]
          },
          "width": { "type": "integer", "minimum": 32, "default": 64 },
          "design": { "type": "string" }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "x", "y", "w", "h"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["cover_block", "pillar"] },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "w": { "type": "integer", "minimum": 16 },
          "h": { "type": "integer", "minimum": 16 },
          "floor_raise": {
            "type": "integer",
            "default": 32,
            "description": "<=24 walk-up pedestal; >24 solid cover/pillar. Keep props off spawn and corridor midlines."
          },
          "in_room": { "type": "string" },
          "design": { "type": "string" }
        }
      }
    },
    "closets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "attach_room", "side"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "attach_room": { "type": "string" },
          "side": { "type": "string", "enum": ["north", "south", "east", "west"] },
          "w": { "type": "integer", "minimum": 64, "default": 96 },
          "h": { "type": "integer", "minimum": 64, "default": 96 },
          "gap": { "type": "integer", "minimum": 16, "default": 32 },
          "floor_height": { "type": "integer", "default": 0 },
          "ceiling_height": { "type": "integer", "default": 128 },
          "light": { "type": "integer", "default": 110 },
          "trigger": { "type": "string", "enum": ["walk", "use"], "default": "walk" },
          "design": { "type": "string" },
          "monsters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["Zombieman", "ShotgunGuy", "Imp"]
                },
                "dx": { "type": "integer", "default": 32 },
                "dy": { "type": "integer", "default": 32 },
                "angle": { "type": "integer", "default": 0 }
              }
            }
          }
        }
      }
    },
    "things": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "x", "y"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Player1Start",
              "Zombieman",
              "ShotgunGuy",
              "Imp",
              "HealthBonus",
              "Clip",
              "Shotgun",
              "ArmorBonus",
              "BlueCard",
              "YellowCard",
              "RedCard",
              "ExitSwitch"
            ]
          },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "angle": { "type": "integer", "default": 0 }
        }
      }
    }
  }
}
